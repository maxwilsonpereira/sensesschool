---
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';
import { withBase } from '../../utils/paths';

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="site-footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img
        src={withBase('/images/brand/senses-logo.webp')}
        alt="Senses Montessori School"
        width="225"
        height="90"
        loading="lazy"
      />
      <p>{page.footer.descriptor}</p>
    </div>

    <nav class="footer__explore" aria-label={page.footer.explore}>
      <h2>{page.footer.explore}</h2>
      <ul>
        {page.nav.items.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
        <li><a href={withBase('/eventos/')}>{page.footer.events}</a></li>
      </ul>
    </nav>

    <div class="footer__contact">
      <h2>{page.footer.contact}</h2>
      <address>
        <a href={`mailto:${school.email}`}>{school.email}</a>
        <a href={school.phoneHref}>{school.phoneDisplay}</a>
        <a href={school.whatsappHref} target="_blank" rel="noopener noreferrer">
          {school.whatsappDisplay}
        </a>
        <span>{school.street}<br />{school.neighborhood}, {school.city} — {school.region}</span>
        <a href={school.mapHref} target="_blank" rel="noopener noreferrer">{page.footer.map}</a>
      </address>
    </div>
  </div>

  <div class="container footer__legal">
    <span>© {year} Senses Montessori School. {page.footer.legal}</span>
    <a href={school.whatsappHref}>{page.footer.admission}</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 7rem) 1.25rem;
    background: var(--rose);
    color: var(--plum-display);
  }

  .footer__grid {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 7vw, 8rem);
    grid-template-columns: minmax(14rem, 1.3fr) minmax(10rem, 0.7fr) minmax(15rem, 1fr);
  }

  .footer__brand img {
    width: clamp(11rem, 16vw, 15rem);
    height: auto;
    mix-blend-mode: multiply;
  }

  .footer__brand p {
    max-width: 25rem;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .footer h2 {
    margin-bottom: 1.25rem;
    color: var(--plum);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer ul,
  address {
    display: grid;
    padding: 0;
    gap: 0.7rem;
    list-style: none;
  }

  address {
    font-style: normal;
  }

  .footer a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
  }

  .footer__legal {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: 1.2rem;
    border-top: 1px solid color-mix(in srgb, var(--plum-display) 22%, transparent);
    font-size: 0.76rem;
  }

  @media (max-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 32rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__brand {
      grid-column: auto;
    }

    .footer__legal {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
