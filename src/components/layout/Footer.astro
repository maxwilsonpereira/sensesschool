---
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/images/brand/senses-logo.webp" alt="Senses" width="225" height="90" />
      <p>{page.footer.descriptor}</p>
      <p>{page.footer.addressLabel}</p>
    </div>

    <div>
      <h2>{page.footer.explore}</h2>
      <ul>
        {page.nav.items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/eventos/">{page.footer.events}</a></li>
      </ul>
    </div>

    <div>
      <h2>{page.footer.contact}</h2>
      <address>
        <a href={`mailto:${school.email}`}>{school.email}</a>
        <a href={school.phoneHref}>{school.phoneDisplay}</a>
        <a href={school.whatsappHref} target="_blank" rel="noopener noreferrer">
          {school.whatsappDisplay}
        </a>
        <span>{school.street}<br />{school.neighborhood}, {school.city} — {school.region}</span>
        <a href={school.mapHref} target="_blank" rel="noopener noreferrer">{page.footer.map} ↗</a>
      </address>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} Senses Montessori School. {page.footer.legal}</span>
    <a href={school.whatsappHref}>{page.footer.admission}</a>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    background: #102f29;
    color: var(--paper);
  }

  .footer__grid {
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: minmax(15rem, 1.5fr) 1fr 1.2fr;
  }

  .footer__brand img {
    width: 9rem;
    height: 4rem;
    margin-bottom: 1.5rem;
    filter: grayscale(1) brightness(5);
    object-fit: contain;
    mix-blend-mode: screen;
  }

  .footer__brand p {
    max-width: 20rem;
    color: color-mix(in srgb, var(--paper) 72%, transparent);
  }

  .footer h2 {
    margin-bottom: 1.5rem;
    color: var(--moss);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer ul {
    display: grid;
    padding: 0;
    margin: 0;
    gap: 0.7rem;
    list-style: none;
  }

  .footer a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
  }

  address {
    display: grid;
    gap: 0.75rem;
    color: color-mix(in srgb, var(--paper) 80%, transparent);
    font-style: normal;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 16%, transparent);
    margin-top: clamp(4rem, 8vw, 7rem);
    color: color-mix(in srgb, var(--paper) 55%, transparent);
    font-size: 0.76rem;
  }

  @media (max-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__brand {
      grid-column: auto;
    }

    .footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
