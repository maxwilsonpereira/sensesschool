---
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';
import { withBase } from '../../utils/paths';

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="site-footer">
  <div class="container footer__content">
    <div class="footer__grid">
      <div class="footer__explore">
        <h2>{page.footer.explore}</h2>
        <ul>
          {page.nav.items.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
          <li><a href={withBase('/eventos/')}>{page.footer.events}</a></li>
        </ul>
      </div>

      <div class="footer__brand">
        <img
          class="footer__logo"
          src={withBase('/images/brand/senses-logo.webp')}
          alt="Senses Montessori School"
          width="225"
          height="90"
          loading="lazy"
        />
        <p>{page.footer.descriptor}</p>
        <p>{page.footer.addressLabel}</p>
      </div>

      <div class="footer__contact">
        <h2>{page.footer.contact}</h2>
        <address>
          <a href={`mailto:${school.email}`}>{school.email}</a>
          <a href={school.phoneHref}>{school.phoneDisplay}</a>
          <a href={school.whatsappHref} target="_blank" rel="noopener noreferrer">
            {school.whatsappDisplay}
          </a>
          <span>{school.street}<br />{school.neighborhood}, {school.city} — {school.region}</span>
          <a href={school.mapHref} target="_blank" rel="noopener noreferrer">{page.footer.map} ↗</a>
        </address>
      </div>
    </div>

    <div class="footer__legal">
      <span>© {year} Senses Montessori School. {page.footer.legal}</span>
      <a href={school.whatsappHref}>{page.footer.admission}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 7rem) 1.25rem;
    background: var(--brand-rose);
    color: var(--brand-plum-deep);
  }

  .footer__grid {
    display: grid;
    align-items: start;
    gap: clamp(2.5rem, 6vw, 7rem);
    grid-template-areas: 'explore brand contact';
    grid-template-columns: 1fr minmax(15rem, 1.25fr) 1.15fr;
  }

  .footer__explore {
    grid-area: explore;
  }

  .footer__brand {
    display: grid;
    justify-items: center;
    text-align: center;
    grid-area: brand;
  }

  .footer__logo {
    width: clamp(10.5rem, 14vw, 13rem);
    height: auto;
    margin-bottom: 0.8rem;
  }

  .footer__brand p {
    max-width: 20rem;
    color: var(--brand-plum-deep);
  }

  .footer__contact {
    grid-area: contact;
  }

  .footer h2 {
    margin-bottom: 1.5rem;
    color: var(--brand-plum);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer ul {
    display: grid;
    padding: 0;
    margin: 0;
    gap: 0.7rem;
    list-style: none;
  }

  .footer a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
  }

  address {
    display: grid;
    gap: 0.75rem;
    color: var(--brand-plum-deep);
    font-style: normal;
  }

  .footer__legal {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--brand-plum) 18%, transparent);
    font-size: 0.76rem;
  }

  @media (max-width: 48rem) {
    .footer__grid {
      gap: 3rem 2rem;
      grid-template-areas:
        'brand brand'
        'explore contact';
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 30rem) {
    .footer__grid {
      grid-template-areas:
        'brand'
        'explore'
        'contact';
      grid-template-columns: 1fr;
    }

    .footer__legal {
      align-items: center;
      flex-direction: column;
      text-align: center;
    }
  }
</style>
