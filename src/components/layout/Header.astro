---
import ButtonLink from '../ui/ButtonLink.astro';
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';
import { withBase } from '../../utils/paths';

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const navLabel = page.lang === 'pt-BR' ? 'Navegação principal' : 'Primary navigation';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="brand" href={withBase(page.path)} aria-label={`${school.name} — home`}>
      <img
        src={withBase('/images/brand/senses-logo.webp')}
        alt=""
        width="225"
        height="90"
      />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      data-menu-toggle
    >
      <span data-menu-label>{page.nav.menu}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 8h16M4 16h16" />
      </svg>
    </button>

    <nav class="primary-nav" id="primary-navigation" aria-label={navLabel} data-nav>
      <ul>
        {page.nav.items.map((item) => (
          <li><a href={withBase(item.href)}>{item.label}</a></li>
        ))}
      </ul>
      <div class="primary-nav__actions">
        <a
          class="language"
          href={withBase(page.alternatePath)}
          hreflang={page.lang === 'pt-BR' ? 'en' : 'pt-BR'}
          lang={page.lang === 'pt-BR' ? 'en' : 'pt-BR'}
        >
          {page.nav.language}
        </a>
        <ButtonLink href={school.whatsappHref} variant="solid" external>
          {page.nav.visit}
        </ButtonLink>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-header]');
    if (!header) return;
    const toggle = header.querySelector('[data-menu-toggle]');
    const nav = header.querySelector('[data-nav]');
    const label = header.querySelector('[data-menu-label]');
    const openLabel = label?.textContent?.trim() || 'Menu';
    const closeLabel = document.documentElement.lang === 'pt-BR' ? 'Fechar' : 'Close';

    const setOpen = (open) => {
      header.toggleAttribute('data-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? closeLabel : openLabel;
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle?.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    nav?.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 1024) setOpen(false);
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .site-header__inner {
    display: grid;
    width: var(--container);
    min-height: 6rem;
    align-items: center;
    margin-inline: auto;
    grid-template-columns: auto minmax(0, 1fr);
  }

  .brand {
    position: relative;
    z-index: 3;
    display: flex;
    width: clamp(8.4rem, 11vw, 10.5rem);
    align-items: center;
  }

  .brand img {
    width: 100%;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .primary-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1.2rem, 2.5vw, 3rem);
  }

  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 1.8vw, 2rem);
    padding: 0;
    list-style: none;
  }

  .primary-nav li a,
  .language {
    position: relative;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-decoration: none;
  }

  .primary-nav li a::after,
  .language::after {
    position: absolute;
    right: 0;
    bottom: -0.38rem;
    left: 0;
    height: 2px;
    background: var(--coral);
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--duration) var(--ease-out);
  }

  .primary-nav li a:hover::after,
  .language:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .primary-nav__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 64rem) {
    .site-header__inner {
      min-height: 5.4rem;
    }

    .menu-toggle {
      position: relative;
      z-index: 3;
      display: inline-flex;
      min-width: 5.8rem;
      min-height: 2.9rem;
      align-items: center;
      justify-content: center;
      justify-self: end;
      gap: 0.65rem;
      padding: 0.55rem 0.8rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-control);
      background: var(--paper-bright);
      color: var(--plum-display);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .menu-toggle svg {
      width: 1.15rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 1.7;
    }

    [data-open] .menu-toggle svg path:first-child {
      transform: translateY(4px) rotate(45deg);
      transform-origin: center;
    }

    [data-open] .menu-toggle svg path:last-child {
      transform: translateY(-4px) rotate(-45deg);
      transform-origin: center;
    }

    .primary-nav {
      position: fixed;
      z-index: 2;
      inset: 0;
      display: grid;
      visibility: hidden;
      width: 100%;
      align-content: center;
      justify-content: stretch;
      padding: 7rem clamp(1.25rem, 7vw, 4rem) 2rem;
      background: var(--rose-soft);
      opacity: 0;
      transition:
        opacity var(--duration) var(--ease-out),
        visibility var(--duration) var(--ease-out);
    }

    [data-open] .primary-nav {
      visibility: visible;
      opacity: 1;
    }

    .primary-nav ul {
      display: grid;
      width: 100%;
      gap: 0;
    }

    .primary-nav li a {
      display: block;
      padding-block: 0.55rem;
      border-bottom: 1px solid var(--line);
      font-family: var(--font-display);
      font-size: clamp(2.3rem, 8vw, 4.4rem);
      font-weight: 400;
      letter-spacing: -0.03em;
      line-height: 1;
    }

    .primary-nav__actions {
      align-items: stretch;
      margin-top: 2rem;
      flex-direction: column;
    }

    .language {
      min-height: 2.75rem;
      align-content: center;
      text-align: center;
    }
  }
</style>
