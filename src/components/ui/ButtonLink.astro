---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'text' | 'light';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'solid',
  external = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['button-link', `button-link--${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span><slot /></span>
  <svg class="button-link__arrow" viewBox="0 0 20 20" aria-hidden="true">
    <path d="M4 10h11M10.5 5.5 15 10l-4.5 4.5" />
  </svg>
</a>

<style>
  .button-link {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 0.82rem 1.1rem 0.82rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .button-link:hover {
    transform: translateY(-2px);
  }

  .button-link--solid {
    background: var(--plum);
    color: var(--white);
  }

  .button-link--solid:hover {
    background: var(--plum-display);
  }

  .button-link--outline {
    border-color: color-mix(in srgb, currentColor 55%, transparent);
    color: var(--plum);
  }

  .button-link--outline:hover {
    border-color: currentColor;
    background: color-mix(in srgb, var(--rose-soft) 48%, transparent);
  }

  .button-link--light {
    background: var(--paper-bright);
    color: var(--plum-display);
  }

  .button-link--light:hover {
    background: var(--white);
  }

  .button-link--text {
    min-height: 2.75rem;
    padding-inline: 0;
    border-radius: 0;
    color: currentColor;
  }

  .button-link--text:hover {
    transform: none;
  }

  .button-link__arrow {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
    transition: transform var(--duration) var(--ease-out);
  }

  .button-link:hover .button-link__arrow {
    transform: translateX(0.22rem);
  }
</style>
