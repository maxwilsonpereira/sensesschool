---
interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'text' | 'light';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'solid',
  external = false,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['button-link', `button-link--${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span><slot /></span>
  <span class="button-link__arrow" aria-hidden="true">↗</span>
</a>

<style>
  .button-link {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 1.1rem;
    padding: 0.78rem 1.15rem 0.78rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .button-link:hover {
    transform: translateY(-2px);
  }

  .button-link--solid {
    background: var(--brand-plum);
    color: var(--white);
  }

  .button-link--solid:hover {
    background: var(--brand-plum-deep);
  }

  .button-link--outline {
    border-color: var(--line);
    color: var(--ink);
  }

  .button-link--outline:hover {
    border-color: var(--ink);
    background: color-mix(in srgb, var(--white) 28%, transparent);
  }

  .button-link--light {
    background: var(--paper);
    color: var(--ink);
  }

  .button-link--light:hover {
    background: var(--white);
  }

  .button-link--text {
    min-height: 2.75rem;
    padding-inline: 0;
    border-radius: 0;
    color: currentColor;
  }

  .button-link--text:hover {
    transform: none;
  }

  .button-link__arrow {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.8rem;
    line-height: 1;
    transition: transform var(--duration) var(--ease-out);
  }

  .button-link:hover .button-link__arrow {
    transform: rotate(45deg);
  }
</style>
