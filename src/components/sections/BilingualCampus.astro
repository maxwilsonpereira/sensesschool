---
import { Picture } from 'astro:assets';
import ButtonLink from '../ui/ButtonLink.astro';
import type { PageContent } from '../../i18n/content';
import { withBase } from '../../utils/paths';
import garden from '../../assets/school/garden.jpg';
import natureDetail from '../../assets/school/nature-detail.jpg';
import toddlerClassroom from '../../assets/school/toddler-classroom.jpg';

interface Props { page: PageContent }
const { page } = Astro.props;
---

<section class="bilingual section" aria-labelledby="bilingual-title">
  <div class="container bilingual__grid">
    <h2 id="bilingual-title">{page.bilingual.title}</h2>
    <div class="bilingual__copy">
      <p>{page.bilingual.body}</p>
      <p>{page.bilingual.note}</p>
    </div>
    <ul class="bilingual__rhythm" aria-label={page.bilingual.eyebrow}>
      {page.hero.annotations.map((annotation) => <li>{annotation}</li>)}
    </ul>
  </div>
</section>

<section class="campus section" id="campus" aria-labelledby="campus-title">
  <div class="container campus__grid">
    <div class="campus__copy">
      <h2 id="campus-title">{page.campus.title}</h2>
      <p>{page.campus.body}</p>
      <p>{page.campus.detail}</p>
      <ButtonLink href={withBase(page.lang === 'pt-BR' ? '/nossa-casa/' : '/en/campus/')} variant="text">
        {page.campus.cta}
      </ButtonLink>
    </div>

    <div class="campus__photos" data-reveal="collage">
      <figure class="campus__main">
        <Picture
          src={garden}
          width={1200}
          widths={[540, 720, 960, 1200]}
          sizes="(max-width: 800px) 100vw, 54vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality="mid"
          alt={page.campus.gardenAlt}
        />
      </figure>
      <figure>
        <Picture
          src={natureDetail}
          width={720}
          widths={[360, 540, 720]}
          sizes="(max-width: 800px) 50vw, 27vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality="mid"
          alt={page.lang === 'pt-BR'
            ? 'Crianças trabalhando com materiais em uma sala da Senses'
            : 'Children working with materials in a Senses classroom'}
        />
      </figure>
      <figure>
        <Picture
          src={toddlerClassroom}
          width={720}
          widths={[360, 540, 720]}
          sizes="(max-width: 800px) 50vw, 27vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality="mid"
          alt={page.lang === 'pt-BR'
            ? 'Sala da Senses iluminada, com mobiliário na escala das crianças'
            : 'Light-filled Senses classroom with child-sized furniture'}
        />
      </figure>
    </div>
  </div>
</section>

<section class="manifesto section" aria-label={page.quote.attribution}>
  <div class="container--narrow" data-reveal="quote">
    <blockquote>“{page.quote.text}”</blockquote>
    <cite>{page.quote.attribution}</cite>
  </div>
</section>

<style>
  .bilingual {
    position: relative;
    overflow: hidden;
    background: var(--plum);
    color: var(--white);
  }

  .bilingual::after {
    position: absolute;
    right: -8rem;
    bottom: -10rem;
    width: 24rem;
    height: 24rem;
    border: 1px solid color-mix(in srgb, var(--coral-soft) 40%, transparent);
    border-radius: 50%;
    content: '';
  }

  .bilingual__grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
  }

  .bilingual h2 {
    max-width: 12ch;
    color: var(--white);
  }

  .bilingual__copy {
    display: grid;
    align-content: end;
    gap: 1.5rem;
    color: color-mix(in srgb, var(--white) 86%, transparent);
  }

  .bilingual__copy p:last-child {
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 30%, transparent);
    color: var(--white);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .bilingual__rhythm {
    display: flex;
    padding: 0;
    color: var(--coral-soft);
    font-family: var(--font-note);
    font-size: clamp(1rem, 2vw, 1.35rem);
    grid-column: 1 / -1;
    list-style: none;
  }

  .bilingual__rhythm li {
    flex: 1;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 25%, transparent);
  }

  .bilingual__rhythm li + li {
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--white) 25%, transparent);
  }

  .campus {
    background: color-mix(in srgb, var(--eucalyptus) 28%, var(--paper-bright));
  }

  .campus__grid {
    display: grid;
    align-items: start;
    gap: clamp(3rem, 7vw, 7rem);
    grid-template-columns: minmax(18rem, 0.72fr) minmax(0, 1.28fr);
  }

  .campus__copy h2 {
    max-width: 11ch;
  }

  .campus__copy > p {
    max-width: 36rem;
    color: color-mix(in srgb, var(--ink) 78%, var(--eucalyptus-deep));
  }

  .campus__copy h2 + p {
    margin-top: 1.8rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .campus__copy > p + p {
    margin-top: 1.2rem;
  }

  .campus__copy :global(.button-link) {
    margin-top: 1rem;
    color: var(--plum-display);
  }

  .campus__photos {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .campus__photos figure {
    min-width: 0;
  }

  .campus__photos :global(picture),
  .campus__photos :global(img) {
    width: 100%;
    height: 100%;
  }

  .campus__photos :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .campus__main {
    grid-column: 1 / -1;
  }

  .campus__main :global(img) {
    aspect-ratio: 16 / 9;
    object-position: center 42%;
  }

  .manifesto {
    background: var(--coral-soft);
    text-align: center;
  }

  .manifesto blockquote {
    color: var(--plum-display);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    letter-spacing: -0.035em;
    line-height: 1.03;
    text-wrap: balance;
  }

  .manifesto cite {
    display: block;
    margin-top: 2rem;
    color: var(--plum);
    font-size: 0.78rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 58rem) {
    .bilingual__grid,
    .campus__grid {
      grid-template-columns: 1fr;
    }

    .bilingual__copy,
    .campus__copy {
      max-width: 46rem;
    }
  }

  @media (max-width: 36rem) {
    .bilingual__rhythm {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
    }

    .campus__photos {
      grid-template-columns: 1fr;
    }

    .campus__main {
      grid-column: auto;
    }

    .campus__photos :global(img),
    .campus__main :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
</style>
