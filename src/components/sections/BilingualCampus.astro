---
import { Picture } from 'astro:assets';
import ButtonLink from '../ui/ButtonLink.astro';
import type { PageContent } from '../../i18n/content';
import { withBase } from '../../utils/paths';
import historicHouse from '../../assets/school/historic-house.jpg';
import garden from '../../assets/school/garden.jpg';
import natureDetail from '../../assets/school/nature-detail.jpg';

interface Props { page: PageContent }
const { page } = Astro.props;
---

<section class="bilingual section">
  <div class="container bilingual__inner">
    <p class="eyebrow">{page.bilingual.eyebrow}</p>
    <h2>{page.bilingual.title}</h2>
    <div class="bilingual__body">
      <p>{page.bilingual.body}</p>
      <p>{page.bilingual.note}</p>
    </div>
  </div>
</section>

<section class="campus section" id="campus">
  <div class="container campus__grid">
    <div class="campus__copy">
      <p class="eyebrow">{page.campus.eyebrow}</p>
      <h2>{page.campus.title}</h2>
      <p>{page.campus.body}</p>
      <p>{page.campus.detail}</p>
      <ButtonLink href={withBase(page.lang === 'pt-BR' ? '/nossa-casa/' : '/en/campus/')} variant="text">
        {page.campus.cta}
      </ButtonLink>
    </div>
    <figure class="campus__main-image">
      <Picture
        src={historicHouse}
        width={960}
        alt={page.campus.imageAlt}
        widths={[480, 720, 960]}
        sizes="(max-width: 768px) 100vw, 52vw"
        formats={['avif']}
        fallbackFormat="webp"
        quality="mid"
      />
    </figure>
    <figure class="campus__garden-image">
      <Picture
        src={garden}
        width={960}
        alt={page.campus.gardenAlt}
        widths={[480, 720, 960]}
        sizes="(max-width: 768px) 60vw, 28vw"
        formats={['avif']}
        fallbackFormat="webp"
        quality="mid"
      />
    </figure>
    <figure class="campus__detail-image" aria-hidden="true">
      <Picture
        src={natureDetail}
        width={480}
        alt=""
        widths={[320, 480, 640]}
        sizes="20vw"
        formats={['avif']}
        fallbackFormat="webp"
        quality="mid"
      />
    </figure>
  </div>
</section>

<section class="manifesto section">
  <div class="container--narrow">
    <blockquote>“{page.quote.text}”</blockquote>
    <cite>{page.quote.attribution}</cite>
  </div>
</section>

<style>
  .bilingual {
    background: var(--brand-plum);
    color: var(--white);
  }

  .bilingual :global(.eyebrow) {
    color: var(--white);
  }

  .bilingual__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    grid-template-columns: 0.55fr 1.35fr 0.9fr;
  }

  .bilingual h2 {
    max-width: 12ch;
  }

  .bilingual__body {
    display: grid;
    align-content: end;
    gap: 1.5rem;
    color: var(--white);
  }

  .bilingual__body p:last-child {
    padding-top: 1.3rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 25%, transparent);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .campus {
    background: var(--paper-deep);
  }

  .campus__grid {
    position: relative;
    display: grid;
    align-items: start;
    gap: 1.2rem;
    grid-template-columns: 0.85fr 0.25fr 1.1fr;
    grid-template-rows: auto auto;
  }

  .campus__copy {
    position: sticky;
    top: 7rem;
    padding-right: clamp(1rem, 4vw, 4rem);
    grid-row: 1 / 3;
  }

  .campus__copy h2 {
    max-width: 11ch;
    margin-block: 1.2rem 1.6rem;
  }

  .campus__copy > p:not(.eyebrow) {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .campus__copy > p + p {
    margin-top: 1rem;
  }

  .campus__copy :global(.button-link) {
    margin-top: 1rem;
  }

  .campus figure {
    overflow: hidden;
  }

  .campus figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .campus figure :global(picture) {
    width: 100%;
    height: 100%;
  }

  .campus__main-image {
    height: clamp(28rem, 62vw, 50rem);
    border-radius: var(--radius-lg) var(--radius-lg) 0 var(--radius-lg);
    grid-column: 2 / 4;
  }

  .campus__garden-image {
    height: clamp(18rem, 35vw, 30rem);
    border-radius: var(--radius-lg) 0 var(--radius-lg) var(--radius-lg);
    grid-column: 2 / 4;
    margin-left: 14%;
  }

  .campus__detail-image {
    position: absolute;
    z-index: 2;
    top: 32%;
    left: 38%;
    width: clamp(9rem, 17vw, 16rem);
    aspect-ratio: 4 / 5;
    border: 0.55rem solid var(--paper-deep);
    border-radius: 100vmax 100vmax var(--radius) var(--radius);
  }

  .manifesto {
    background: var(--brand-rose);
    text-align: center;
  }

  .manifesto blockquote {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 4.8rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .manifesto cite {
    display: block;
    margin-top: 2rem;
    font-size: 0.74rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  @media (max-width: 58rem) {
    .bilingual__inner {
      grid-template-columns: 1fr;
    }

    .bilingual__body {
      max-width: 40rem;
    }

    .campus__grid {
      grid-template-columns: 1fr 1fr;
    }

    .campus__copy {
      position: static;
      grid-column: 1 / -1;
      grid-row: auto;
      margin-bottom: 2rem;
    }

    .campus__main-image {
      grid-column: 1 / -1;
    }

    .campus__garden-image {
      grid-column: 1 / -1;
    }

    .campus__detail-image {
      top: 48%;
      left: 4%;
    }
  }

  @media (max-width: 36rem) {
    .campus__main-image {
      height: 30rem;
    }

    .campus__garden-image {
      height: 20rem;
      margin-left: 0;
    }

    .campus__detail-image {
      display: none;
    }
  }
</style>
