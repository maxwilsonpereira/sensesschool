---
import ButtonLink from '../ui/ButtonLink.astro';
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';
import { withBase } from '../../utils/paths';

interface Props { page: PageContent }
const { page } = Astro.props;
---

<section class="faq section" id="questions" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__heading">
      <h2 id="faq-title">{page.faq.title}</h2>
      <ButtonLink href={withBase(page.lang === 'pt-BR' ? '/educacao/#duvidas' : '/en/education/#questions')} variant="text">
        {page.faq.cta}
      </ButtonLink>
    </div>
    <div class="faq__items">
      {page.faq.items.map((item, index) => (
        <details open={index === 0} data-faq-item>
          <summary>
            <strong>{item.question}</strong>
            <i aria-hidden="true"></i>
          </summary>
          <div class="faq__answer" data-faq-answer>
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="visit section" id="visit" aria-labelledby="visit-title">
  <div class="container visit__grid" data-reveal="visit">
    <div>
      <h2 id="visit-title">{page.visit.title}</h2>
      <p>{page.visit.body}</p>
    </div>
    <div class="visit__action-panel">
      <p>{page.visit.eyebrow}</p>
      <ButtonLink href={school.whatsappHref} variant="light" external>{page.visit.cta}</ButtonLink>
      <ButtonLink href={`mailto:${school.email}`} variant="text">{page.visit.contact}</ButtonLink>
      <address>
        <span>{school.street}</span>
        <span>{school.neighborhood} · {school.city}</span>
      </address>
    </div>
  </div>
</section>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const faqAnimations = new Map<HTMLDetailsElement, Animation>();
  const faqStates = new Map<HTMLDetailsElement, 'opening' | 'closing'>();

  document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach((details) => {
    const summary = details.querySelector('summary');
    const answer = details.querySelector<HTMLElement>('[data-faq-answer]');
    const answerContent = answer?.firstElementChild as HTMLElement | null;
    if (!summary || !answer || !answerContent) return;

    const measureAnswerHeight = () => {
      const clone = answer.cloneNode(true) as HTMLElement;
      Object.assign(clone.style, {
        position: 'fixed',
        top: '0',
        left: '-10000px',
        width: `${details.getBoundingClientRect().width}px`,
        height: 'auto',
        visibility: 'hidden',
        pointerEvents: 'none',
        opacity: '1',
        clipPath: 'none',
        overflow: 'visible',
      });
      document.body.append(clone);
      const height = clone.scrollHeight;
      clone.remove();
      return height;
    };

    summary.addEventListener('click', (event) => {
      if (reducedMotion.matches || typeof answer.animate !== 'function') return;
      event.preventDefault();

      const currentState = faqStates.get(details);
      const opening = !details.open || currentState === 'closing';
      const currentHeight = details.open ? answer.getBoundingClientRect().height : 0;
      const currentOpacity = details.open
        ? Number.parseFloat(getComputedStyle(answer).opacity)
        : 0;

      faqAnimations.get(details)?.cancel();
      if (opening && !details.open) details.open = true;

      // A width-matched copy avoids the transient zero-height state that some
      // browsers expose while a native disclosure is being opened.
      const targetHeight = opening ? measureAnswerHeight() : 0;
      answer.style.willChange = 'height, opacity, clip-path';
      const animation = answer.animate(
        [
          {
            height: `${currentHeight}px`,
            opacity: currentOpacity,
            clipPath: opening ? 'inset(0 0 10% 0)' : 'inset(0)',
          },
          {
            height: `${targetHeight}px`,
            opacity: opening ? 1 : 0,
            clipPath: opening ? 'inset(0)' : 'inset(0 0 10% 0)',
          },
        ],
        {
          duration: opening ? 520 : 400,
          easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          fill: 'both',
        },
      );

      faqAnimations.set(details, animation);
      faqStates.set(details, opening ? 'opening' : 'closing');

      animation.onfinish = () => {
        if (faqAnimations.get(details) !== animation) return;
        if (!opening) details.open = false;
        animation.cancel();
        answer.style.removeProperty('will-change');
        faqAnimations.delete(details);
        faqStates.delete(details);
      };
    });
  });
</script>

<style>
  .faq {
    padding-top: 0;
    background: var(--paper-bright);
  }

  .faq__grid {
    display: grid;
    gap: clamp(3rem, 8vw, 8rem);
    grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.35fr);
  }

  .faq__heading h2 {
    max-width: 8ch;
  }

  .faq__heading :global(.button-link) {
    margin-top: 1rem;
    color: var(--plum);
  }

  details {
    border-top: 1px solid var(--line);
  }

  details:last-child {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: grid;
    min-height: 6rem;
    align-items: center;
    gap: 1rem;
    cursor: pointer;
    grid-template-columns: 1fr 1.5rem;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary strong {
    color: var(--plum-display);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.2;
  }

  summary i,
  summary i::after {
    display: block;
    width: 1.2rem;
    height: 1px;
    background: currentColor;
    content: '';
    transition: transform var(--duration) var(--ease-out);
  }

  summary i::after {
    transform: rotate(90deg);
  }

  details[open] summary i::after {
    transform: rotate(0);
  }

  .faq__answer {
    overflow: clip;
  }

  .faq__answer p {
    max-width: 46rem;
    padding: 0 3rem 2rem 0;
    color: var(--ink-soft);
  }

  .visit {
    background: var(--eucalyptus-deep);
    color: var(--white);
  }

  .visit__grid {
    display: grid;
    align-items: end;
    gap: clamp(3rem, 8vw, 9rem);
    grid-template-columns: minmax(0, 1.3fr) minmax(18rem, 0.7fr);
  }

  .visit h2 {
    max-width: 13ch;
    color: var(--white);
    font-size: clamp(2.8rem, 6vw, 5.7rem);
  }

  .visit h2 + p {
    max-width: 45rem;
    margin-top: 1.8rem;
    color: color-mix(in srgb, var(--white) 84%, transparent);
    font-size: var(--step-1);
  }

  .visit__action-panel {
    display: grid;
    align-items: stretch;
  }

  .visit__action-panel > p {
    margin-bottom: 1rem;
    color: var(--coral-soft);
    font-family: var(--font-note);
    font-size: 1.1rem;
    transform: rotate(-2deg);
  }

  .visit__action-panel :global(.button-link) {
    width: 100%;
  }

  .visit__action-panel :global(.button-link--text) {
    margin-top: 0.4rem;
    color: var(--white);
  }

  address {
    display: grid;
    gap: 0.2rem;
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid color-mix(in srgb, var(--white) 28%, transparent);
    color: color-mix(in srgb, var(--white) 82%, transparent);
    font-size: var(--step--1);
    font-style: normal;
  }

  @media (max-width: 54rem) {
    .faq__grid,
    .visit__grid {
      grid-template-columns: 1fr;
    }

    .faq__heading {
      max-width: 36rem;
    }

    .visit__action-panel {
      max-width: 28rem;
    }
  }
</style>
