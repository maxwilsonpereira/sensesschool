---
import { Picture } from 'astro:assets';
import ButtonLink from '../ui/ButtonLink.astro';
import type { PageContent } from '../../i18n/content';
import { withBase } from '../../utils/paths';
import nursery from '../../assets/school/nursery.jpg';
import toddler from '../../assets/school/toddler-classroom.jpg';
import prepared from '../../assets/school/prepared-environment.jpg';

interface Props { page: PageContent }
const { page } = Astro.props;
const images = { nursery, toddler, prepared } as const;
---

<section class="programs section" id="programs" aria-labelledby="programs-title">
  <div class="container programs__heading">
    <h2 id="programs-title">{page.programs.title}</h2>
    <div>
      <p>{page.programs.intro}</p>
      <ButtonLink href={withBase(page.lang === 'pt-BR' ? '/programas/' : '/en/programs/')} variant="text">
        {page.programs.cta}
      </ButtonLink>
    </div>
  </div>

  <div class="container program-grid" data-reveal="sequence">
    {page.programs.cards.map((program) => (
      <article class="program">
        <Picture
          src={images[program.image]}
          width={720}
          widths={[420, 540, 720, 900]}
          sizes="(max-width: 700px) 100vw, 33vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality="mid"
          alt={page.lang === 'pt-BR'
            ? `Ambiente preparado para o programa ${program.title} na Senses`
            : `Prepared environment for the ${program.title} program at Senses`}
        />
        <div class="program__content">
          <p class="program__age">{program.age}</p>
          <h3>{program.title}</h3>
          <p>{program.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .programs {
    background: var(--rose-soft);
  }

  .programs__heading {
    display: grid;
    align-items: end;
    gap: clamp(2rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
  }

  .programs__heading h2 {
    max-width: 12ch;
  }

  .programs__heading > div {
    max-width: 38rem;
    color: var(--ink-soft);
  }

  .programs__heading :global(.button-link) {
    margin-top: 1.2rem;
    color: var(--plum);
  }

  .program-grid {
    display: grid;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .program {
    min-width: 0;
    padding: clamp(1rem, 2vw, 1.6rem);
  }

  .program + .program {
    border-left: 1px solid var(--line);
  }

  .program :global(picture) {
    width: 100%;
  }

  .program :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: filter 500ms var(--ease-out), transform 500ms var(--ease-out);
  }

  .program:hover :global(img) {
    filter: saturate(1.06);
    transform: scale(0.992);
  }

  .program__content {
    padding-block: 1.6rem 0.5rem;
  }

  .program__age {
    color: var(--plum);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .program h3 {
    margin-block: 0.6rem 1rem;
    font-size: clamp(1.75rem, 2.8vw, 2.65rem);
  }

  .program__content > p:last-child {
    color: var(--ink-soft);
  }

  .program:nth-child(1) :global(img) {
    object-position: center 62%;
  }

  .program:nth-child(2) :global(img) {
    object-position: center;
  }

  .program:nth-child(3) :global(img) {
    object-position: 52% center;
  }

  @media (max-width: 54rem) {
    .programs__heading {
      align-items: start;
      grid-template-columns: 1fr;
    }

    .program-grid {
      grid-template-columns: 1fr;
    }

    .program {
      display: grid;
      align-items: center;
      gap: 1.5rem;
      grid-template-columns: minmax(13rem, 0.9fr) minmax(0, 1.1fr);
    }

    .program + .program {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .program__content {
      padding-block: 0;
    }
  }

  @media (max-width: 38rem) {
    .program {
      display: block;
      padding-block: 1.25rem 2rem;
    }

    .program__content {
      padding-top: 1.3rem;
    }
  }
</style>
