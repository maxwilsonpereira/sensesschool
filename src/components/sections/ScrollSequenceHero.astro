---
import ButtonLink from '../ui/ButtonLink.astro';
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';
import { withBase } from '../../utils/paths';

interface SequenceConfig {
  frameBase: string;
  frameCount: number;
  extension: 'webp' | 'avif' | 'jpg';
  poster: string;
  scrollHeightVh?: number;
  fit?: 'contain' | 'cover';
  initialFrame?: number;
}

interface Props {
  page: PageContent;
  config?: SequenceConfig;
}

const { page } = Astro.props;
const config: SequenceConfig = Astro.props.config ?? {
  frameBase: withBase('/hero-sequence/placeholder/frame-'),
  frameCount: 48,
  extension: 'webp',
  poster: withBase('/hero-sequence/placeholder/frame-048.webp'),
  scrollHeightVh: 300,
  fit: 'contain',
  initialFrame: 0,
};
---

<section
  class="scroll-hero"
  style={`--hero-scroll-height-desktop: ${config.scrollHeightVh}vh`}
  data-scroll-sequence
  data-frame-base={config.frameBase}
  data-frame-count={config.frameCount}
  data-extension={config.extension}
  data-fit={config.fit}
  data-initial-frame={config.initialFrame}
>
  <div class="scroll-hero__sticky">
    <div class="scroll-hero__copy">
      <p class="eyebrow">{page.hero.eyebrow}</p>
      <h1>{page.hero.title}</h1>
      <p class="scroll-hero__lead">{page.hero.body}</p>
      <div class="scroll-hero__actions">
        <ButtonLink href="#philosophy">{page.hero.primaryCta}</ButtonLink>
        <ButtonLink href={school.whatsappHref} variant="outline" external>
          {page.hero.secondaryCta}
        </ButtonLink>
      </div>
    </div>

    <div class="scroll-hero__visual" aria-label={page.hero.canvasLabel} role="img">
      <img
        class="scroll-hero__poster"
        src={config.poster}
        alt={page.hero.fallbackAlt}
        width="1200"
        height="900"
        fetchpriority="high"
      />
      <canvas class="scroll-hero__canvas" aria-hidden="true"></canvas>
    </div>

    <div class="scroll-cue" aria-hidden="true">
      <span>{page.hero.scrollLabel}</span>
      <i></i>
    </div>

    <p class="scroll-hero__word" aria-hidden="true">senses</p>
  </div>
</section>

<script is:inline>
  (() => {
    const roots = document.querySelectorAll('[data-scroll-sequence]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    roots.forEach((root) => {
      if (!(root instanceof HTMLElement) || reducedMotion.matches) return;
      const canvas = root.querySelector('canvas');
      const poster = root.querySelector('.scroll-hero__poster');
      if (!(canvas instanceof HTMLCanvasElement)) return;
      const context = canvas.getContext('2d', { alpha: false, desynchronized: true });
      if (!context) return;

      const frameBase = root.dataset.frameBase || '';
      const extension = root.dataset.extension || 'webp';
      const frameCount = Number(root.dataset.frameCount || 1);
      const initialFrame = Number(root.dataset.initialFrame || 0);
      const fit = root.dataset.fit === 'cover' ? 'cover' : 'contain';
      const paperColor = getComputedStyle(root).getPropertyValue('--paper').trim() || '#f4f0e8';
      const frames = new Map();
      let requestedFrame = initialFrame;
      let displayedFrame = -1;
      let ticking = false;

      const frameUrl = (index) =>
        `${frameBase}${String(index + 1).padStart(3, '0')}.${extension}`;

      const draw = (image, index) => {
        const width = canvas.width;
        const height = canvas.height;
        const imageRatio = image.naturalWidth / image.naturalHeight;
        const canvasRatio = width / height;
        const shouldFitWidth = fit === 'cover' ? imageRatio < canvasRatio : imageRatio > canvasRatio;
        const drawWidth = shouldFitWidth ? width : height * imageRatio;
        const drawHeight = shouldFitWidth ? width / imageRatio : height;
        const x = (width - drawWidth) / 2;
        const y = (height - drawHeight) / 2;

        context.fillStyle = paperColor;
        context.fillRect(0, 0, width, height);
        context.drawImage(image, x, y, drawWidth, drawHeight);
        displayedFrame = index;
        root.dataset.ready = 'true';
        if (poster instanceof HTMLImageElement) poster.setAttribute('aria-hidden', 'true');
      };

      const drawNearest = (target) => {
        if (frames.has(target)) {
          draw(frames.get(target), target);
          return;
        }

        for (let distance = 1; distance < frameCount; distance += 1) {
          const before = target - distance;
          const after = target + distance;
          if (frames.has(before)) return draw(frames.get(before), before);
          if (frames.has(after)) return draw(frames.get(after), after);
        }
      };

      const loadFrame = (index) => {
        const safeIndex = Math.max(0, Math.min(frameCount - 1, index));
        if (frames.has(safeIndex)) return Promise.resolve(frames.get(safeIndex));
        const image = new Image();
        image.decoding = 'async';
        const promise = new Promise((resolve, reject) => {
          image.onload = () => {
            frames.set(safeIndex, image);
            if (safeIndex === requestedFrame || displayedFrame < 0) draw(image, safeIndex);
            resolve(image);
          };
          image.onerror = reject;
        });
        image.src = frameUrl(safeIndex);
        return promise;
      };

      const resize = () => {
        const rect = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
        const width = Math.max(1, Math.round(rect.width * dpr));
        const height = Math.max(1, Math.round(rect.height * dpr));
        if (canvas.width !== width || canvas.height !== height) {
          canvas.width = width;
          canvas.height = height;
          drawNearest(requestedFrame);
        }
      };

      const update = () => {
        ticking = false;
        const rect = root.getBoundingClientRect();
        const travel = Math.max(1, rect.height - window.innerHeight);
        const progress = Math.max(0, Math.min(1, -rect.top / travel));
        requestedFrame = Math.round(progress * (frameCount - 1));
        if (requestedFrame !== displayedFrame) {
          drawNearest(requestedFrame);
          void loadFrame(requestedFrame);
          void loadFrame(requestedFrame + 1);
          void loadFrame(requestedFrame - 1);
        }
      };

      const requestUpdate = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      new ResizeObserver(() => {
        resize();
        requestUpdate();
      }).observe(canvas);

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', requestUpdate, { passive: true });

      resize();
      void Promise.all([loadFrame(initialFrame), loadFrame(frameCount - 1)]).then(requestUpdate);

      let warmIndex = 0;
      const warmNextFrame = () => {
        while (warmIndex < frameCount && frames.has(warmIndex)) warmIndex += 1;
        if (warmIndex >= frameCount) return;
        const index = warmIndex;
        warmIndex += 1;
        void loadFrame(index).finally(() => setTimeout(warmNextFrame, 55));
      };

      setTimeout(warmNextFrame, 900);
    });
  })();
</script>

<style>
  .scroll-hero {
    position: relative;
    min-height: var(--hero-scroll-height-desktop);
    background: var(--paper);
  }

  .scroll-hero__sticky {
    position: sticky;
    top: 0;
    display: grid;
    width: 100%;
    height: 100svh;
    min-height: 42rem;
    align-items: center;
    overflow: clip;
    padding: 7.75rem max(1rem, calc((100% - 82rem) / 2)) 5rem;
    grid-template-columns: minmax(17rem, 0.9fr) minmax(25rem, 1.1fr);
  }

  .scroll-hero__copy {
    position: relative;
    z-index: 3;
    max-width: 35rem;
    padding-bottom: 2rem;
  }

  .scroll-hero h1 {
    max-width: 8ch;
    margin-top: 1.2rem;
  }

  .scroll-hero__lead {
    max-width: 33rem;
    margin-top: 1.5rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .scroll-hero__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .scroll-hero__visual {
    position: absolute;
    z-index: 1;
    top: 6rem;
    right: max(-4rem, calc((100vw - 96rem) / 2));
    width: min(63vw, 60rem);
    height: calc(100svh - 7rem);
    min-height: 35rem;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    background: var(--paper-deep);
  }

  .scroll-hero__poster,
  .scroll-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scroll-hero__poster {
    object-fit: cover;
    opacity: 1;
    transition: opacity 400ms var(--ease-out);
  }

  .scroll-hero__canvas {
    opacity: 0;
  }

  [data-ready='true'] .scroll-hero__poster {
    opacity: 0;
  }

  [data-ready='true'] .scroll-hero__canvas {
    opacity: 1;
  }

  .scroll-hero__word {
    position: absolute;
    z-index: 0;
    right: 0;
    bottom: -0.23em;
    color: color-mix(in srgb, var(--brand-rose) 28%, transparent);
    font-family: var(--font-display);
    font-size: clamp(7rem, 22vw, 25rem);
    letter-spacing: -0.04em;
    line-height: 0.7;
    user-select: none;
  }

  .scroll-cue {
    position: absolute;
    z-index: 3;
    bottom: 1.5rem;
    left: max(1rem, calc((100% - 82rem) / 2));
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .scroll-cue i {
    display: block;
    width: 3rem;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: breathe 1.8s ease-in-out infinite;
  }

  @keyframes breathe {
    50% { transform: scaleX(0.45); }
  }

  @media (max-width: 64rem) {
    .scroll-hero__sticky {
      align-items: start;
      padding-top: 7.5rem;
      grid-template-columns: 1fr;
    }

    .scroll-hero__copy {
      max-width: 33rem;
    }

    .scroll-hero__visual {
      top: auto;
      right: -2rem;
      bottom: 0;
      width: min(72vw, 46rem);
      height: 58vh;
      min-height: 24rem;
      border-radius: 48% 0 0 0;
    }

    .scroll-cue {
      bottom: 1rem;
    }
  }

  @media (min-width: 44.01rem) and (max-width: 64rem) {
    .scroll-hero h1 {
      font-size: clamp(3.75rem, 7vw, 5rem);
    }

    .scroll-hero__lead {
      max-width: 29rem;
      font-size: 1rem;
    }

    .scroll-hero__visual {
      height: 38vh;
      min-height: 22rem;
    }
  }

  @media (max-width: 44rem) {
    .scroll-hero {
      min-height: 240vh;
    }

    .scroll-hero__sticky {
      min-height: 40rem;
      padding-top: 5.6rem;
    }

    .scroll-hero .eyebrow {
      font-size: 0.66rem;
    }

    .scroll-hero__copy {
      padding-bottom: 0;
    }

    .scroll-hero h1 {
      max-width: 8.5ch;
      margin-top: 0.8rem;
      font-size: clamp(2.85rem, 13vw, 4.7rem);
    }

    .scroll-hero__lead {
      max-width: 27rem;
      margin-top: 0.9rem;
      font-size: 0.98rem;
      line-height: 1.45;
    }

    .scroll-hero__actions {
      margin-top: 1.2rem;
    }

    .scroll-hero__visual {
      right: -1rem;
      bottom: 0;
      left: 1rem;
      width: auto;
      height: 43vh;
      min-height: 18rem;
      border-radius: 45% 45% 0 0;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-height: 45rem) and (min-width: 45rem) {
    .scroll-hero__sticky {
      min-height: 35rem;
    }

    .scroll-hero__visual {
      min-height: 28rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hero {
      min-height: 100svh;
    }

    .scroll-hero__sticky {
      position: relative;
    }

    .scroll-hero__canvas {
      display: none;
    }

    .scroll-hero__poster {
      opacity: 1;
    }

    .scroll-cue {
      display: none;
    }
  }
</style>
