---
import { Picture } from 'astro:assets';
import type { PageContent } from '../../i18n/content';
import { school } from '../../i18n/content';
import ButtonLink from '../ui/ButtonLink.astro';
import campusBaby from '../../assets/school/campus-baby.jpg';
import campusJunior from '../../assets/school/campus-junior.jpg';
import campusSenior from '../../assets/school/campus-senior.jpg';
import campusGarden from '../../assets/school/campus-garden.jpg';

interface Props { page: PageContent }
const { page } = Astro.props;
const campus = page.campusPage;
const isPortuguese = page.lang === 'pt-BR';
const historyId = isPortuguese ? 'historia' : 'history';
const roomsId = isPortuguese ? 'salas' : 'rooms';
const gardenId = isPortuguese ? 'jardim' : 'garden';
const roomImages = [campusBaby, campusJunior, campusSenior] as const;
const chapterKinds = ['history', 'rooms', 'garden'] as const;
---

<section class="campus-hero" aria-labelledby="campus-title">
  <div class="campus-hero__grid">
    <div class="campus-hero__copy">
      <p class="campus-hero__eyebrow">{campus.hero.eyebrow}</p>
      <h1 id="campus-title">
        {campus.hero.title.split('. ').map((sentence, index, parts) => {
          const words = sentence.split(' ');
          const accentWord = words.pop() ?? '';

          return (
            <span>
              {words.join(' ')}{' '}
              {index === 0
                ? <span class="hero__accent">{accentWord}</span>
                : accentWord}
              {index < parts.length - 1 ? '.' : ''}
            </span>
          );
        })}
      </h1>
      <p class="campus-hero__lead">{campus.hero.lead}</p>
      <ButtonLink href={school.whatsappHref} external>{campus.hero.cta}</ButtonLink>
    </div>

    <nav class="campus-chapters" aria-label={campus.hero.chaptersLabel}>
      <ol>
        {campus.hero.chapters.map((chapter, index) => (
          <li class={`campus-chapter campus-chapter--${chapterKinds[index]}`}>
            <a href={chapter.href}>
              <span class="campus-chapter__label">
                <span class="campus-chapter__number">{chapter.number}</span>
                <strong>{chapter.label}</strong>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h13M13 7l5 5-5 5" />
                </svg>
              </span>
              <span class="campus-block-scene" aria-hidden="true">
                <span class="campus-block campus-block--1"></span>
                <span class="campus-block campus-block--2"></span>
                <span class="campus-block campus-block--3"></span>
                <span class="campus-block campus-block--4"></span>
                <span class="campus-block campus-block--5"></span>
                <span class="campus-block campus-block--6"></span>
                <span class="campus-block campus-block--7"></span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<section class="campus-history section" id={historyId} aria-labelledby="history-title">
  <div class="container campus-history__grid" data-campus-reveal="history">
    <div class="campus-history__heading">
      <span aria-hidden="true">01</span>
      <h2 id="history-title">{campus.history.title}</h2>
    </div>
    <div class="campus-history__copy">
      {campus.history.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="campus-history__note">{campus.history.note}</p>
  </div>
</section>

<section class="campus-rooms section" id={roomsId} aria-labelledby="rooms-title">
  <div class="container campus-rooms__intro" data-campus-reveal="pair">
    <div>
      <span aria-hidden="true">02</span>
      <h2 id="rooms-title">{campus.rooms.title}</h2>
    </div>
    <p>{campus.rooms.intro}</p>
  </div>

  <div class="container campus-room-list">
    {campus.rooms.items.map((room, index) => (
      <article class="campus-room" id={room.id} data-campus-reveal="room">
        <figure class="campus-room__media">
          <Picture
            src={roomImages[index]}
            width={1200}
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 768px) calc(100vw - 1.5rem), 52vw"
            formats={['avif']}
            fallbackFormat="webp"
            quality="mid"
            alt={room.alt}
            loading="lazy"
          />
          <figcaption>{room.age}</figcaption>
        </figure>
        <div class="campus-room__copy">
          <h3>{room.title}</h3>
          {room.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>
    ))}
  </div>
</section>

<section class="campus-garden" id={gardenId} aria-labelledby="garden-title">
  <div class="container campus-garden__grid" data-campus-reveal="garden">
    <div class="campus-garden__copy">
      <span aria-hidden="true">03</span>
      <h2 id="garden-title">{campus.garden.title}</h2>
      {campus.garden.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p class="campus-garden__note">{campus.garden.note}</p>
    </div>
    <figure class="campus-garden__media">
      <Picture
        src={campusGarden}
        width={1440}
        widths={[640, 960, 1200, 1440]}
        sizes="(max-width: 768px) calc(100vw - 1.5rem), 58vw"
        formats={['avif']}
        fallbackFormat="webp"
        quality="mid"
        alt={campus.garden.imageAlt}
        loading="lazy"
      />
    </figure>
  </div>
</section>

<section class="campus-visit" aria-labelledby="campus-visit-title">
  <div class="container campus-visit__grid" data-campus-reveal="visit">
    <div>
      <h2 id="campus-visit-title">{campus.visit.title}</h2>
      <p>{campus.visit.body}</p>
    </div>
    <div class="campus-visit__actions">
      <ButtonLink href={school.whatsappHref} variant="light" external>{campus.visit.cta}</ButtonLink>
      <ButtonLink href={school.mapHref} variant="text" external>{campus.visit.map}</ButtonLink>
      <address>
        <span>{campus.visit.contactLabel}</span>
        <a href={`mailto:${school.email}`}>{school.email}</a>
        <a href={school.phoneHref}>{school.phoneDisplay}</a>
        <span>{school.street}<br />{school.neighborhood}, {school.city} — {school.region}</span>
      </address>
    </div>
  </div>
</section>

<script>
  const campusMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!campusMotion.matches && 'IntersectionObserver' in window) {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-campus-reveal]'));
    const blockScenes = Array.from(document.querySelectorAll<HTMLElement>('.campus-block-scene'));
    const mobileBlockMotion = window.matchMedia('(max-width: 64rem) and (hover: none)');
    document.documentElement.classList.add('campus-motion-ready');

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });

    requestAnimationFrame(() => {
      items.forEach((item) => {
        if (item.getBoundingClientRect().top < window.innerHeight * 0.92) {
          item.classList.add('is-visible');
        } else {
          observer.observe(item);
        }
      });

      if (mobileBlockMotion.matches) {
        const blockObserver = new IntersectionObserver((entries, currentObserver) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-settled');
            currentObserver.unobserve(entry.target);
          });
        }, { rootMargin: '-49% 0px -49% 0px', threshold: 0 });

        blockScenes.forEach((scene) => {
          blockObserver.observe(scene);
        });
      }
    });
  }
</script>

<style>
  .campus-hero {
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }

  .campus-hero__grid {
    display: grid;
    min-height: calc(100svh - 6rem);
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .campus-hero__copy {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(4rem, 8vh, 7rem) clamp(2rem, 4vw, 5rem) clamp(3.5rem, 7vh, 6rem)
      max(clamp(1.25rem, 5vw, 6rem), calc((100vw - 90rem) / 2 + 3rem));
    flex-direction: column;
  }

  .campus-hero__eyebrow {
    margin-bottom: 1.8rem;
    color: var(--plum);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .campus-hero h1 {
    max-width: 9.5ch;
    font-size: clamp(3.2rem, 3.7vw, 5.45rem);
  }

  .campus-hero h1 > span {
    display: block;
  }

  .campus-hero__lead {
    max-width: 35rem;
    margin-block: 1.8rem 2rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .campus-chapters {
    min-width: 0;
    padding: 0.55rem;
    background: var(--paper);
  }

  .campus-chapters ol {
    display: grid;
    width: 100%;
    height: 100%;
    padding: 0;
    gap: 0.55rem;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    list-style: none;
  }

  .campus-chapter {
    min-height: 0;
    overflow: hidden;
    border-radius: var(--radius-control);
  }

  .campus-chapter a {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 0;
    grid-template-columns: clamp(6rem, 7vw, 7.5rem) minmax(0, 1fr);
    color: var(--plum-display);
    text-decoration: none;
  }

  .campus-chapter--history { background: color-mix(in srgb, var(--gold) 22%, var(--paper-bright)); }
  .campus-chapter--rooms { background: color-mix(in srgb, var(--rose-soft) 82%, var(--paper-bright)); }
  .campus-chapter--garden { background: color-mix(in srgb, var(--eucalyptus) 25%, var(--paper-bright)); }

  .campus-chapter__label {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    margin: 0.65rem;
    padding: 0.75rem 0.55rem;
    border-radius: var(--radius-control);
    background: var(--paper-bright);
    box-shadow: 0 0.55rem 1.4rem color-mix(in srgb, var(--plum-display) 9%, transparent);
    flex-direction: column;
    gap: 0.32rem;
    font-family: var(--font-display);
    line-height: 1.05;
    text-align: center;
    transition: background-color var(--duration) var(--ease-out), color var(--duration) var(--ease-out);
  }

  .campus-chapter__number {
    color: var(--brand-plum);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .campus-chapter__label strong {
    font-weight: 400;
  }

  .campus-chapter__label svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
    transition: transform var(--duration) var(--ease-out);
  }

  .campus-chapter a:hover .campus-chapter__label,
  .campus-chapter a:focus-visible .campus-chapter__label {
    background: var(--plum);
    color: var(--white);
  }

  .campus-chapter a:hover .campus-chapter__number,
  .campus-chapter a:focus-visible .campus-chapter__number {
    color: var(--coral-soft);
  }

  .campus-chapter a:hover .campus-chapter__label svg,
  .campus-chapter a:focus-visible .campus-chapter__label svg {
    transform: translateX(0.2rem);
  }

  .campus-block-scene {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .campus-block-scene::after {
    position: absolute;
    right: 14%;
    bottom: 7%;
    left: 14%;
    height: 10%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
    content: '';
    filter: blur(0.8rem);
  }

  .campus-block {
    position: absolute;
    z-index: 1;
    display: block;
    border-radius: 0.28rem;
    background: var(--block-color, var(--gold));
    box-shadow:
      inset 0.16rem 0.16rem 0 color-mix(in srgb, var(--white) 24%, transparent),
      inset -0.18rem -0.18rem 0 color-mix(in srgb, var(--ink) 9%, transparent),
      0 0.55rem 1.15rem color-mix(in srgb, var(--ink) 13%, transparent);
    transition: transform 460ms var(--ease-out);
  }

  .campus-chapter--history .campus-block--1 { --block-color: var(--gold); left: 38%; bottom: 13%; width: 29%; height: 39%; }
  .campus-chapter--history .campus-block--2 { --block-color: var(--coral); left: 34%; bottom: 52%; width: 37%; height: 28%; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .campus-chapter--history .campus-block--3 { --block-color: var(--plum-display); left: 49%; bottom: 13%; width: 9%; height: 23%; border-radius: 0.3rem 0.3rem 0 0; }
  .campus-chapter--history .campus-block--4 { --block-color: var(--eucalyptus); left: 50%; bottom: 40%; width: 7%; aspect-ratio: 1; border-radius: 50%; }
  .campus-chapter--history .campus-block--5 { --block-color: var(--eucalyptus-deep); left: 18%; bottom: 13%; width: 13%; height: 49%; }
  .campus-chapter--history .campus-block--6 { --block-color: var(--plum); left: 73%; bottom: 13%; width: 10%; height: 35%; }
  .campus-chapter--history .campus-block--7 { --block-color: var(--coral-soft); left: 73%; bottom: 48%; width: 10%; height: 16%; }

  .campus-chapter--rooms .campus-block--1 { --block-color: var(--gold); left: 19%; bottom: 16%; width: 62%; height: 11%; }
  .campus-chapter--rooms .campus-block--2 { --block-color: var(--plum); left: 23%; bottom: 27%; width: 15%; aspect-ratio: 1; border-radius: 50%; }
  .campus-chapter--rooms .campus-block--3 { --block-color: var(--eucalyptus); left: 43%; bottom: 27%; width: 18%; height: 28%; border-radius: 50% 50% 0.25rem 0.25rem; }
  .campus-chapter--rooms .campus-block--4 { --block-color: var(--coral); left: 66%; bottom: 27%; width: 14%; aspect-ratio: 1; }
  .campus-chapter--rooms .campus-block--5 { --block-color: var(--gold); left: 66%; bottom: 41%; width: 14%; height: 22%; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .campus-chapter--rooms .campus-block--6 { --block-color: var(--plum-display); left: 19%; bottom: 9%; width: 7%; height: 12%; }
  .campus-chapter--rooms .campus-block--7 { --block-color: var(--plum-display); left: 74%; bottom: 9%; width: 7%; height: 12%; }

  .campus-chapter--garden .campus-block--1 { --block-color: var(--gold); left: 19%; bottom: 12%; width: 63%; height: 13%; }
  .campus-chapter--garden .campus-block--2 { --block-color: var(--plum); left: 47%; bottom: 25%; width: auto; height: 31%; aspect-ratio: 0.55; }
  .campus-chapter--garden .campus-block--3 { --block-color: var(--eucalyptus); left: 34%; bottom: 43%; width: auto; height: 48%; aspect-ratio: 1; border-radius: 50%; }
  .campus-chapter--garden .campus-block--4 { --block-color: var(--eucalyptus-deep); left: 49%; bottom: 44%; width: auto; height: 44%; aspect-ratio: 1; border-radius: 50%; }
  .campus-chapter--garden .campus-block--5 { --block-color: var(--coral-soft); left: 26%; bottom: 39%; width: auto; height: 38%; aspect-ratio: 1; border-radius: 50%; }
  .campus-chapter--garden .campus-block--6 { --block-color: var(--gold); right: 15%; top: 14%; width: auto; height: 18%; aspect-ratio: 1; border-radius: 50%; }
  .campus-chapter--garden .campus-block--7 { --block-color: var(--coral); left: 27%; bottom: 25%; width: auto; height: 18%; aspect-ratio: 0.6; clip-path: polygon(50% 0, 100% 100%, 0 100%); }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .campus-chapter a:hover .campus-block--1,
    .campus-chapter a:focus-visible .campus-block--1 { transform: translateY(-0.2rem); }
    .campus-chapter a:hover .campus-block--2,
    .campus-chapter a:focus-visible .campus-block--2 { transform: translateY(-0.5rem) rotate(-1.5deg); }
    .campus-chapter a:hover .campus-block--3,
    .campus-chapter a:focus-visible .campus-block--3 { transform: translateY(-0.75rem) rotate(1.5deg); }
    .campus-chapter a:hover .campus-block--4,
    .campus-chapter a:focus-visible .campus-block--4 { transform: translate(0.18rem, -0.45rem) rotate(2deg); }
    .campus-chapter a:hover .campus-block--5,
    .campus-chapter a:focus-visible .campus-block--5 { transform: translate(-0.16rem, -0.32rem) rotate(-1deg); }
    .campus-chapter a:hover .campus-block--6,
    .campus-chapter a:focus-visible .campus-block--6 { transform: translateY(-0.38rem) rotate(1deg); }
    .campus-chapter a:hover .campus-block--7,
    .campus-chapter a:focus-visible .campus-block--7 { transform: translateY(-0.58rem) rotate(-2deg); }
  }

  @media (max-width: 64rem) and (hover: none) and (prefers-reduced-motion: no-preference) {
    .campus-block--1 { --settle-transform: translateY(-0.2rem); --settle-delay: 0ms; }
    .campus-block--2 { --settle-transform: translateY(-0.5rem) rotate(-1.5deg); --settle-delay: 45ms; }
    .campus-block--3 { --settle-transform: translateY(-0.75rem) rotate(1.5deg); --settle-delay: 90ms; }
    .campus-block--4 { --settle-transform: translate(0.18rem, -0.45rem) rotate(2deg); --settle-delay: 135ms; }
    .campus-block--5 { --settle-transform: translate(-0.16rem, -0.32rem) rotate(-1deg); --settle-delay: 180ms; }
    .campus-block--6 { --settle-transform: translateY(-0.38rem) rotate(1deg); --settle-delay: 225ms; }
    .campus-block--7 { --settle-transform: translateY(-0.58rem) rotate(-2deg); --settle-delay: 270ms; }

    .campus-block-scene.is-settled .campus-block {
      animation: campus-block-settle 1000ms var(--ease-out) var(--settle-delay) both;
    }
  }

  @keyframes campus-block-settle {
    from { transform: var(--settle-transform); }
    to { transform: none; }
  }

  .campus-history {
    background: var(--paper-bright);
  }

  .campus-history__grid {
    display: grid;
    align-items: start;
    gap: clamp(2rem, 5vw, 6rem);
    grid-template-columns: minmax(16rem, 0.85fr) minmax(18rem, 1fr) minmax(12rem, 0.55fr);
  }

  .campus-history__heading > span,
  .campus-rooms__intro > div > span,
  .campus-garden__copy > span {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--brand-plum);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .campus-history__heading h2 {
    max-width: 8ch;
  }

  .campus-history__copy {
    display: grid;
    gap: 1.25rem;
  }

  .campus-history__copy p:first-child {
    color: var(--plum-display);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .campus-history__note {
    align-self: end;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--plum);
    font-family: var(--font-note);
    font-size: clamp(0.9rem, 1.25vw, 1.08rem);
    line-height: 1.45;
    transform: rotate(-1.5deg);
  }

  .campus-rooms {
    background: var(--rose-soft);
  }

  .campus-rooms__intro {
    display: grid;
    align-items: end;
    gap: clamp(2rem, 9vw, 10rem);
    margin-bottom: clamp(4rem, 8vw, 7rem);
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.75fr);
  }

  .campus-rooms__intro h2 {
    max-width: 11ch;
  }

  .campus-rooms__intro > p {
    max-width: 42rem;
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .campus-room-list {
    display: grid;
    gap: clamp(5rem, 10vw, 9rem);
  }

  .campus-room {
    display: grid;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 8rem);
    grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.88fr);
  }

  .campus-room:nth-child(even) {
    grid-template-columns: minmax(18rem, 0.88fr) minmax(0, 1.12fr);
  }

  .campus-room:nth-child(even) .campus-room__media {
    grid-column: 2;
  }

  .campus-room:nth-child(even) .campus-room__copy {
    grid-column: 1;
    grid-row: 1;
  }

  .campus-room__media {
    position: relative;
    min-height: clamp(23rem, 43vw, 39rem);
    overflow: hidden;
    box-shadow: var(--shadow-photo);
  }

  .campus-room__media :global(picture),
  .campus-room__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .campus-room__media :global(img) {
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  .campus-room:first-child .campus-room__media :global(img) { object-position: 48% center; }
  .campus-room:nth-child(2) .campus-room__media :global(img) { object-position: center; }
  .campus-room:nth-child(3) .campus-room__media :global(img) { object-position: 48% center; }

  .campus-room__media figcaption {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    padding: 0.7rem 0.9rem;
    background: var(--paper-bright);
    color: var(--plum-display);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .campus-room__copy {
    max-width: 38rem;
  }

  .campus-room__copy h3 {
    margin-bottom: 1.5rem;
    font-size: clamp(2.25rem, 3.6vw, 4.25rem);
  }

  .campus-room__copy p {
    color: var(--ink-soft);
  }

  .campus-room__copy p + p {
    margin-top: 1rem;
  }

  .campus-garden {
    padding-block: var(--space-section);
    background: var(--eucalyptus-deep);
    color: var(--white);
  }

  .campus-garden__grid {
    display: grid;
    align-items: center;
    gap: clamp(3rem, 7vw, 8rem);
    grid-template-columns: minmax(18rem, 0.82fr) minmax(0, 1.18fr);
  }

  .campus-garden h2 {
    max-width: 9ch;
    margin-bottom: 2rem;
    color: var(--white);
  }

  .campus-garden__copy > span {
