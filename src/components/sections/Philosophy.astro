---
import { Picture } from 'astro:assets';
import type { PageContent } from '../../i18n/content';
import preparedEnvironment from '../../assets/school/prepared-environment.jpg';

interface Props { page: PageContent }
const { page } = Astro.props;
const photoAlt = page.lang === 'pt-BR'
  ? 'Ambiente Montessori da Senses com materiais organizados e acessíveis às crianças'
  : 'Senses Montessori environment with materials arranged within children’s reach';
---

<section class="philosophy section" id="philosophy" aria-labelledby="philosophy-title">
  <div class="container philosophy__opening">
    <h2 id="philosophy-title">{page.intro.title}</h2>
    <div class="philosophy__copy">
      <p>{page.intro.lead}</p>
      <p>{page.intro.detail}</p>
    </div>
  </div>

  <div class="container philosophy__evidence" data-reveal="paper">
    <figure>
      <Picture
        src={preparedEnvironment}
        width={1200}
        widths={[540, 720, 960, 1200]}
        sizes="(max-width: 800px) 100vw, 68vw"
        formats={['avif']}
        fallbackFormat="webp"
        quality="mid"
        alt={photoAlt}
      />
      <figcaption>{page.method.body}</figcaption>
    </figure>
    <p class="philosophy__note" aria-hidden="true">
      {page.lang === 'pt-BR' ? 'o ambiente também educa' : 'the environment teaches too'}
    </p>
  </div>

  <div class="method container" aria-labelledby="method-title">
    <div class="method__intro">
      <h2 id="method-title">{page.method.title}</h2>
      <p>{page.method.body}</p>
    </div>
    <ol class="method__list">
      {page.method.principles.map((principle) => (
        <li>
          <h3>{principle.title}</h3>
          <p>{principle.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .philosophy {
    background: var(--paper-bright);
  }

  .philosophy__opening {
    display: grid;
    align-items: start;
    gap: clamp(2rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr);
  }

  .philosophy__opening h2 {
    max-width: 11ch;
  }

  .philosophy__copy {
    display: grid;
    max-width: 42rem;
    gap: 1.5rem;
    color: var(--ink-soft);
  }

  .philosophy__copy p:first-child {
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .philosophy__copy p:last-child {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .philosophy__evidence {
    display: grid;
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: clamp(4rem, 9vw, 8rem);
    grid-template-columns: minmax(0, 1.55fr) minmax(11rem, 0.45fr);
  }

  figure {
    display: grid;
    gap: 1rem;
  }

  figure :global(picture) {
    width: 100%;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    box-shadow: var(--shadow-photo);
  }

  figcaption {
    max-width: 55rem;
    color: var(--plum-display);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .philosophy__note {
    max-width: 13ch;
    margin-bottom: 1.5rem;
    color: var(--plum);
    font-family: var(--font-note);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1.2;
    transform: rotate(-4deg);
  }

  .philosophy__note::after {
    display: block;
    width: 5rem;
    height: 0.2rem;
    margin-top: 0.7rem;
    border-radius: 50%;
    background: var(--gold);
    content: '';
    transform: rotate(2deg);
  }

  .method {
    display: grid;
    gap: clamp(3rem, 7vw, 8rem);
    padding-top: var(--space-section);
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
  }

  .method__intro h2 {
    max-width: 10ch;
  }

  .method__intro p {
    max-width: 30rem;
    margin-top: 1.6rem;
    color: var(--ink-soft);
  }

  .method__list {
    display: grid;
    padding: 0;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }

  .method__list li {
    display: grid;
    align-items: start;
    gap: 1.5rem;
    padding-block: 1.8rem;
    border-top: 1px solid var(--line);
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr);
  }

  .method__list h3 {
    color: var(--plum);
    font-size: clamp(1.45rem, 2.2vw, 2.1rem);
    line-height: 1.05;
  }

  .method__list p {
    max-width: 40rem;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .philosophy__opening,
    .method {
      grid-template-columns: 1fr;
    }

    .philosophy__copy {
      max-width: 46rem;
    }
  }

  @media (max-width: 42rem) {
    .philosophy__evidence {
      grid-template-columns: 1fr;
    }

    .philosophy__note {
      margin: 0;
    }

    figure :global(img) {
      aspect-ratio: 4 / 3;
    }

    .method__list li {
      gap: 0.85rem;
      grid-template-columns: 1fr;
    }
  }
</style>
