---
import { Picture } from 'astro:assets';
import type { PageContent } from '../../i18n/content';
import preparedEnvironment from '../../assets/school/prepared-environment-crop.jpg';
import whiteBrushStroke from '../../assets/design/white-brush-stroke-paint.png';

interface Props { page: PageContent }
const { page } = Astro.props;
const photoAlt = page.lang === 'pt-BR'
  ? 'Ambiente Montessori da Senses com materiais organizados e acessíveis às crianças'
  : 'Senses Montessori environment with materials arranged within children’s reach';
---

<section class="philosophy section" id="philosophy" aria-labelledby="philosophy-title">
  <div class="container philosophy__opening">
    <h2 id="philosophy-title">{page.intro.title}</h2>
    <div class="philosophy__copy">
      <p>{page.intro.lead}</p>
      <p>{page.intro.detail}</p>
    </div>
  </div>

  <div class="philosophy__evidence" data-reveal="paper">
    <figure>
      <div class="philosophy__media">
        <Picture
          src={preparedEnvironment}
          width={1440}
          widths={[720, 960, 1200, 1440]}
          sizes="100vw"
          formats={['avif']}
          fallbackFormat="webp"
          quality="mid"
          alt={photoAlt}
        />
        <p class="philosophy__note" aria-hidden="true">
          <img class="philosophy__note-brush" src={whiteBrushStroke.src} alt="" />
          <span>{page.lang === 'pt-BR' ? 'o ambiente também educa' : 'the environment teaches too'}</span>
        </p>
      </div>
      <figcaption>{page.method.body}</figcaption>
    </figure>
  </div>

  <div class="method container" aria-labelledby="method-title">
    <div class="method__intro">
      <h2 id="method-title">{page.method.title}</h2>
      <p>{page.method.body}</p>
    </div>
    <ol class="method__list">
      {page.method.principles.map((principle) => (
        <li>
          <h3>{principle.title}</h3>
          <p>{principle.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .philosophy {
    background: var(--paper-bright);
  }

  .philosophy__opening {
    display: grid;
    align-items: start;
    gap: clamp(2rem, 6vw, 7rem);
    grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr);
  }

  .philosophy__opening h2 {
    max-width: 11ch;
  }

  .philosophy__copy {
    display: grid;
    max-width: 42rem;
    gap: 1.5rem;
    color: var(--ink-soft);
  }

  .philosophy__copy p:first-child {
    color: var(--ink);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .philosophy__copy p:last-child {
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .philosophy__evidence {
    margin-top: clamp(4rem, 9vw, 8rem);
  }

  figure {
    display: grid;
    gap: 1.25rem;
  }

  .philosophy__media {
    position: relative;
  }

  .philosophy__media :global(picture) {
    width: 100%;
  }

  .philosophy__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center bottom;
  }

  figcaption {
    width: var(--container);
    max-width: 55rem;
    margin-inline: auto;
    color: var(--plum-display);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.35;
  }

  .philosophy__note {
    position: absolute;
    z-index: 1;
    right: calc(clamp(1.25rem, 7vw, 8rem) + 35px);
    bottom: calc(clamp(1.15rem, 3vw, 2.75rem) + 50px);
    width: min(15rem, 28vw);
    padding: 0.5rem 0.85rem 0.65rem;
    color: var(--plum);
    font-family: var(--font-note);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    font-weight: 700;
    isolation: isolate;
    line-height: 1.2;
    text-align: center;
    transform: rotate(2deg);
  }

  .philosophy__media .philosophy__note-brush {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: 185%;
    height: 250%;
    max-width: none;
    aspect-ratio: auto;
    object-fit: fill;
    object-position: center;
    transform: translate(-50%, -50%) rotate(-2deg);
  }

  .philosophy__note span {
    position: relative;
    z-index: 1;
    -webkit-text-stroke: 0.012em var(--plum);
  }

  .philosophy__note::after {
    display: block;
    width: 8rem;
    height: 0.4rem;
    margin: 0.55rem auto 0;
    border-radius: 50%;
    background: var(--gold);
    content: '';
    transform: translateX(-30px);
  }

  .method {
    display: grid;
    gap: clamp(3rem, 7vw, 8rem);
    padding-top: var(--space-section);
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
  }

  .method__intro h2 {
    max-width: 10ch;
  }

  .method__intro p {
    max-width: 30rem;
    margin-top: 1.6rem;
    color: var(--ink-soft);
  }

  .method__list {
    display: grid;
    padding: 0;
    border-bottom: 1px solid var(--line);
    list-style: none;
  }

  .method__list li {
    display: grid;
    align-items: start;
    gap: 1.5rem;
    padding-block: 1.8rem;
    border-top: 1px solid var(--line);
    grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 1.3fr);
  }

  .method__list h3 {
    color: var(--plum);
    font-size: clamp(1.45rem, 2.2vw, 2.1rem);
    line-height: 1.05;
  }

  .method__list p {
    max-width: 40rem;
    color: var(--ink-soft);
  }

  @media (max-width: 56rem) {
    .philosophy__opening,
    .method {
      grid-template-columns: 1fr;
    }

    .philosophy__copy {
      max-width: 46rem;
    }
  }

  @media (max-width: 42rem) {
    .philosophy__note {
      right: calc(6.5rem - 30px);
      bottom: calc(1.1rem + 50px);
      width: min(13rem, 54vw);
      padding: 0.45rem 0.65rem 0.55rem;
      font-size: clamp(1rem, 4.5vw, 1.25rem);
    }

    .method__list li {
      gap: 0.85rem;
      grid-template-columns: 1fr;
    }
  }
</style>
