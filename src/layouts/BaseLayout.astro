---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { PageContent } from '../i18n/content';
import { school } from '../i18n/content';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  page: PageContent;
}

const { page } = Astro.props;
const site = Astro.site ?? new URL('https://maxwilsonpereira.github.io');
const canonical = new URL(withBase(page.path), site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Preschool',
  '@id': new URL(withBase('/#school'), site).href,
  name: school.name,
  url: canonical.href,
  description: page.meta.description,
  logo: new URL(withBase('/images/brand/senses-logo.webp'), site).href,
  email: school.email,
  telephone: '+55-11-2614-0201',
  address: {
    '@type': 'PostalAddress',
    streetAddress: school.street,
    addressLocality: school.city,
    addressRegion: school.region,
    addressCountry: school.country,
  },
  areaServed: {
    '@type': 'City',
    name: 'São Paulo',
  },
  knowsAbout: [
    'Montessori education',
    'Early childhood education',
    'Bilingual education',
    'Prepared environment',
  ],
};
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#faf5e9" />
    <meta name="generator" content={Astro.generator} />
    <title>{page.meta.title}</title>
    <meta name="description" content={page.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(withBase('/'), site)} />
    <link rel="alternate" hreflang="en" href={new URL(withBase('/en/'), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(withBase('/'), site)} />
    <link rel="icon" href={withBase('/images/brand/senses-logo.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={school.name} />
    <meta property="og:title" content={page.meta.title} />
    <meta property="og:description" content={page.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase('/og.jpg'), site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={page.hero.title} />
    <meta property="og:locale" content={page.lang === 'pt-BR' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={page.lang === 'pt-BR' ? 'en_US' : 'pt_BR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(withBase('/og.jpg'), site)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <!-- THESIS: Every child is a scientist, and the homepage behaves like an atelier of observation rather than a generic premium-school brochure. OWN-WORLD: warm tactile paper, plum editorial type, rose/coral/eucalyptus accents, authentic documentary photography, graphite rules, and sparse handwritten observations. STORY: families encounter the child as capable, see how Montessori, bilingualism, environment, and leadership support development, then schedule a visit. FIRST VIEWPORT: an oversized thesis and two visible actions occupy the left field; one authentic child-at-work photograph owns the right field with three quiet process annotations. FORM: Ateliê de Descobertas, grounded position 1, seed 72db8bf4. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <a class="skip-link" href="#main-content">{page.skip}</a>
    <Header page={page} />
    <main id="main-content"><slot /></main>
    <Footer page={page} />
  </body>
</html>
